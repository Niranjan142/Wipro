using System;
using System.Collections.Generic;

class Transaction
{
    public string TransactionId;
    public double Amount;

    public Transaction(string id, double amt)
    {
        TransactionId = id;
        Amount = amt;
    }
}

class BankingSystem
{
    List<Transaction> transactionHistory = new List<Transaction>();
    Dictionary<string, double> accountBalances = new Dictionary<string, double>();
    Queue<Transaction> pendingTransactions = new Queue<Transaction>();
    Stack<Transaction> rollbackStack = new Stack<Transaction>();
    HashSet<string> transactionIds = new HashSet<string>();

    public void AddAccount(string accountNumber, double balance)
    {
        accountBalances[accountNumber] = balance;
    }

    public void AddTransaction(Transaction t)
    {
        if (!transactionIds.Contains(t.TransactionId))
        {
            pendingTransactions.Enqueue(t);
            transactionIds.Add(t.TransactionId);
        }
        else
        {
            Console.WriteLine("Duplicate Transaction ID");
        }
    }

    public void ProcessTransaction(string accountNumber)
    {
        if (pendingTransactions.Count == 0)
        {
            Console.WriteLine("No pending transactions");
            return;
        }

        Transaction t = pendingTransactions.Dequeue();

        if (accountBalances.ContainsKey(accountNumber))
        {
            accountBalances[accountNumber] += t.Amount;
            transactionHistory.Add(t);
            rollbackStack.Push(t);
            Console.WriteLine($"Processed: {t.TransactionId}");
        }
        else
        {
            Console.WriteLine("Account not found");
        }
    }

    public void Rollback(string accountNumber)
    {
        if (rollbackStack.Count == 0)
        {
            Console.WriteLine("Nothing to rollback");
            return;
        }

        Transaction t = rollbackStack.Pop();

        if (accountBalances.ContainsKey(accountNumber))
        {
            accountBalances[accountNumber] -= t.Amount;
            transactionHistory.Remove(t);
            Console.WriteLine($"Rolled back: {t.TransactionId}");
        }
    }

    public void DisplayBalance(string accountNumber)
    {
        if (accountBalances.ContainsKey(accountNumber))
            Console.WriteLine($"Balance: {accountBalances[accountNumber]}");
        else
            Console.WriteLine("Account not found");
    }
}

class Program
{
    static void Main()
    {
        BankingSystem bank = new BankingSystem();

        Console.Write("Enter number of accounts: ");
        int accCount = int.Parse(Console.ReadLine());

        for (int i = 0; i < accCount; i++)
        {
            Console.Write("Enter Account Number: ");
            string accNo = Console.ReadLine();

            Console.Write("Enter Initial Balance: ");
            double bal = double.Parse(Console.ReadLine());

            bank.AddAccount(accNo, bal);
        }

        Console.Write("Enter number of transactions: ");
        int tCount = int.Parse(Console.ReadLine());

        for (int i = 0; i < tCount; i++)
        {
            Console.Write("Enter Transaction ID: ");
            string id = Console.ReadLine();

            Console.Write("Enter Amount (+deposit / -withdraw): ");
            double amt = double.Parse(Console.ReadLine());

            bank.AddTransaction(new Transaction(id, amt));
        }

        Console.Write("Enter account to process transactions: ");
        string processAcc = Console.ReadLine();

        Console.Write("How many transactions to process: ");
        int processCount = int.Parse(Console.ReadLine());

        for (int i = 0; i < processCount; i++)
        {
            bank.ProcessTransaction(processAcc);
        }

        bank.DisplayBalance(processAcc);

        Console.Write("Do rollback? (yes/no): ");
        string choice = Console.ReadLine();

        if (choice.ToLower() == "yes")
        {
            Console.Write("How many rollbacks: ");
            int r = int.Parse(Console.ReadLine());

            for (int i = 0; i < r; i++)
            {
                bank.Rollback(processAcc);
            }
        }

        bank.DisplayBalance(processAcc);
    }
}
